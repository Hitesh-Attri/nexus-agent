# Resilient LLM gateway — the agent's reasoning happens through this.
GATEWAY_URL=http://localhost:8080

# nexus-rag — backs the search_knowledge_base tool.
RAG_URL=http://localhost:8081

# Safety rail: hard cap on reason->act->observe cycles per request.
MAX_ITERATIONS=6

# Seconds. Per-call timeouts for the gateway and for a single tool run.
GATEWAY_TIMEOUT=60
TOOL_TIMEOUT=20